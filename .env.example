# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Banco no servidor (Docker Compose). Use uma senha longa: openssl rand -base64 24
POSTGRES_PASSWORD=""

# Primeira conta da administradora. Criada pelo seed; depois apague a senha daqui.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Aparecem no site. WhatsApp com DDD, só números (ex.: 67999990000).
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_FACEBOOK=""

# Só para rodar no computador (no servidor o Docker Compose monta sozinho).
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/jdv"
DATABASE_URL_TEST="postgresql://USUARIO:SENHA@localhost:5432/jdv_test"
UPLOAD_DIR="./uploads"

# Porta local do site no servidor (o proxy aponta para ela)
APP_PORT=3010
